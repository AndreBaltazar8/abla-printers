// No hardware: a POSIX pseudo-terminal stands in for the printer UART.
import "../src/native.ab"
import "abla/serial"
import "abla/device"
import "abla/io"
import "abla/bytes"
import "abla/process/time"
import "abla/sys/linux"
import "abla/unsafe/memory"

private trusted noescape extern:"c" fun posix_openpt(flags: i32): i32
private trusted noescape extern:"c" fun grantpt(descriptor: i32): i32
private trusted noescape extern:"c" fun unlockpt(descriptor: i32): i32
private trusted noescape extern:"c" fun ptsname(descriptor: i32): i64*
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool

trusted fun main: int {
    val master=posix_openpt(i32(2 | (if(ablaHostIsMacOS())131072 else 256)))
    if(master<0)return 1
    if(grantpt(master)!=0 || unlockpt(master)!=0){linuxSyscall1(3,int(master));return 2}
    val path=nativeCString(ptsname(master))
    if(path==""){linuxSyscall1(3,int(master));return 3}
    val flags=linuxSyscall3(72,int(master),3,0)
    if(flags<0 || linuxSyscall3(72,int(master),4,flags | 2048)<0){linuxSyscall1(3,int(master));return 4}
    var keeper=deviceOpen(path,true)
    if(!keeper.opened()){linuxSyscall1(3,int(master));return 7}
    val job=printerJob().text("ação €\nraw").qr("ATCUD:TEST-1").feed(3).cut().drawer()
    val encoded=encodeEscPos(job)
    val transport=SerialPrinterTransport(path,SerialSettings(baud=19200))
    val sent=printerSendEscPos(job,transport)
    val received=byteBuffer()
    val scratch=nativeByteBuffer(4096)
    val start=monotonicMilliseconds()
    while(received.size()<encoded.bytes.size && monotonicMilliseconds()-start<2000){
        val amount=linuxSyscall3(0,int(master),nativePointerAddress(scratch.address),4096)
        if(amount>0){var at=0;while(at<amount){received.appendText(byteEncode(scratch.load(at)));at=at+1}}
        else if(amount== -11 || amount== -35 || amount== -4)sleep(1)
        else break
    }
    scratch.close()
    keeper.close()
    linuxSyscall1(3,int(master))
    if(!sent.succeeded || sent.outcome!="submitted" || sent.bytesWritten!=encoded.bytes.size)return 5
    if(received.toText()!=encoded.bytes)return 6
    println("PASS serial PTY exact bytes: CP858, LF (no CR conversion), QR, cut and drawer; no hardware")
    0
}
